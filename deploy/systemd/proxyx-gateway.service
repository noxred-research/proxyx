[Unit]
Description=ProxyX pool gateway: CONNECT and SOCKS5 ingress, leasing, pool API
Documentation=https://github.com/noxred-research/proxyx/blob/main/docs/gateway.md
After=network-online.target postgresql.service valkey.service
Wants=network-online.target

[Service]
Type=exec
User=proxyx
Group=proxyx
ExecStart=/usr/local/bin/proxyx gateway --config /etc/proxyx/pool.toml
KillSignal=SIGTERM
# SIGTERM turns /readyz to 503 `draining` at once and open tunnels run for up to
# `drain_timeout` (300 s by default) plus a 15 s margin; keep this above both.
TimeoutStopSec=345
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576
# The gateway refuses to start below 2 x max_connections + 512 open files.
EnvironmentFile=-/etc/proxyx/pool.env

# Hardening: the role needs the network and its own files, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

[Install]
WantedBy=multi-user.target
