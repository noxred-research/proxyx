[Unit]
Description=ProxyX control plane API: sessions, captures, GraphQL
Documentation=https://github.com/noxred-research/proxyx/blob/main/docs/control-api.md
After=network-online.target postgresql.service valkey.service
Wants=network-online.target

[Service]
Type=exec
User=proxyx
Group=proxyx
ExecStart=/usr/local/bin/proxyx control api --config /etc/proxyx/control.toml
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=2
EnvironmentFile=-/etc/proxyx/control.env

# Hardening: the role needs the network and its own files, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

[Install]
WantedBy=multi-user.target
