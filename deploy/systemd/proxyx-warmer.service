[Unit]
Description=ProxyX pool warmer: warming, keepalive, quality checks, sweeper
Documentation=https://github.com/noxred-research/proxyx/blob/main/docs/gateway.md
After=network-online.target postgresql.service valkey.service
Wants=network-online.target

[Service]
Type=exec
User=proxyx
Group=proxyx
ExecStart=/usr/local/bin/proxyx warmer --config /etc/proxyx/pool.toml
KillSignal=SIGTERM
# In-flight creates and resets get 10 s to finish after SIGTERM.
TimeoutStopSec=40
Restart=on-failure
RestartSec=2
EnvironmentFile=-/etc/proxyx/pool.env

# Hardening: the role needs the network and its own files, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

[Install]
WantedBy=multi-user.target
