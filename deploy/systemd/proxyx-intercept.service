[Unit]
Description=ProxyX session proxy: routing, TLS interception and capture
Documentation=https://github.com/noxred-research/proxyx/blob/main/docs/session-proxy.md
After=network-online.target valkey.service
Wants=network-online.target

[Service]
Type=exec
User=proxyx
Group=proxyx
ExecStart=/usr/local/bin/proxyx-intercept --config /etc/proxyx/intercept.toml
KillSignal=SIGTERM
# `shutdown_drain_timeout_secs` (300 s by default) for open tunnels, then up to 30 s
# to flush buffered captures, plus a margin; keep this above the sum.
TimeoutStopSec=360
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576
EnvironmentFile=-/etc/proxyx/intercept.env
# `ca.type = "generate"` keeps its CA under the state directory.
StateDirectory=proxyx-intercept
StateDirectoryMode=0750

# Hardening: the role needs the network and its own files, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

[Install]
WantedBy=multi-user.target
