[Unit]
Description=ProxyX edge: self-hosted multi-IP forward proxy
Documentation=https://github.com/noxred-research/proxyx/blob/main/docs/edge-proxy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=proxyx
Group=proxyx
ExecStartPre=/usr/local/bin/proxyx edge --check --config /etc/proxyx/edge.toml
ExecStart=/usr/local/bin/proxyx edge --config /etc/proxyx/edge.toml
# SIGHUP re-reads the configuration (users, rules, pools, limits, new listeners)
# without dropping open tunnels, and reopens the access log after logrotate.
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
# `server.shutdown_grace` (30 s by default) is how long open tunnels may finish.
TimeoutStopSec=45
Restart=on-failure
RestartSec=2

# One descriptor per client connection and one per tunnel side.
LimitNOFILE=1048576
UMask=0027
LogsDirectory=proxyx-edge
LogsDirectoryMode=0750

# Hardening. The process needs the network, the interface list (netlink, for
# `interface = "eth0"` pools) and the right to bind ports below 1024 when a
# listener asks for one; nothing else.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
