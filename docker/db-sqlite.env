# Compose env file for the `sqlite` profile (see docker-compose.yml and docs/databases.md).
# One file per plane on the shared `sqlite-data` volume; one host only.
PROXYX_POOL_DB_URL=sqlite:///var/lib/proxyx/sqlite/pool.db?mode=rwc
PROXYX_CONTROL_DB_URL=sqlite:///var/lib/proxyx/sqlite/control.db?mode=rwc
